{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "feature", "fix", "docs", "style", "refactor", "sonar", "lint", "chore", "migration", "test"]
    ],
    "subject-case": [0],
    "header-max-length": [2, "always", 120],
    "body-max-line-length": [0]
  }
}
